{
  "name": "@polaris/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contrats partagés : schémas zod, catalogue de permissions, types et SDK généré",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "default": "./dist/sdk/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "sdk:generate": "openapi-typescript ../../apps/api/openapi.json -o src/sdk/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@polaris/config": "workspace:*",
    "openapi-typescript": "^7.6.1",
    "vitest": "^3.2.4"
  }
}
