# Polaris — configuration du VPS (copiée en /opt/polaris/.env par install.sh, qui génère les secrets).
# Ne jamais versionner le fichier .env rempli. Rotation des secrets : docs/runbooks/rotate-secrets.md.

# ---- Domaine et certificats ----
APP_DOMAIN=app.exemple.bj              # un seul domaine : pages + /api/* (DNS A → IP du VPS)
ACME_EMAIL=ops@exemple.bj              # contact Let's Encrypt (expiration, incidents)

# ---- Images ----
GHCR_REPOSITORY=boostage-online/polaris
POLARIS_TAG=main                       # sha ou tag déployé (deploy.sh le positionne)

# ---- PostgreSQL (générés par install.sh : openssl rand -base64 32) ----
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_PLATFORM_PASSWORD=

# ---- Secrets applicatifs (générés par install.sh) ----
JWT_KID=
JWT_PRIVATE_JWK=
JWT_PUBLIC_JWK=
RECEIPT_SECRET=
PAYMENT_MASTER_KEY=                    # scelle les clés des comptes marchands (base64 32 octets)
APP_MASTER_KEY=                        # scelle les secrets TOTP (base64 32 octets)
BACKUP_PASSPHRASE=                     # chiffre les sauvegardes — À CONSERVER HORS DU SERVEUR

# ---- Comportement ----
LOG_LEVEL=info
CSP_ENFORCE=false                      # true après une semaine sans rapport CSP
RATE_LIMIT_GLOBAL_PER_MINUTE=300
IMPERSONATION_TTL_MINUTES=30
SMS_PROVIDER=log                       # fournisseur SMS à brancher (décision avant production n° 4)
EMAIL_PROVIDER=log
SENTRY_DSN=

# ---- Sauvegardes ----
BACKUP_HOUR_UTC=01                     # 02 h à Porto-Novo
BACKUP_KEEP_DAYS=14                    # rotation locale ; la copie distante garde 35 jours

# ---- Copie hors site (profil `offsite`, recommandé : docker compose --profile offsite up -d) ----
# Cloudflare R2 (10 Go gratuits) ou tout S3 : créer un bucket privé et un jeton d'accès.
RCLONE_TYPE=s3
RCLONE_PROVIDER=Cloudflare
RCLONE_ENDPOINT=                       # ex. https://<compte>.r2.cloudflarestorage.com
RCLONE_ACCESS_KEY_ID=
RCLONE_SECRET_ACCESS_KEY=
RCLONE_BUCKET=polaris-backups
