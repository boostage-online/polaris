# ---- Base de données (rôle applicatif, SANS BYPASSRLS) ----
DATABASE_URL=postgres://polaris_app:polaris_app@localhost:5432/polaris
# Rôle plateforme (BYPASSRLS) : module Platform et migrations uniquement
DATABASE_URL_PLATFORM=postgres://polaris_owner:polaris@localhost:5432/polaris
# Base de test (les tests d'intégration la réinitialisent)
DATABASE_URL_TEST=postgres://polaris_owner:polaris@localhost:5432/polaris_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Clés ES256 au format JWK JSON (générer : pnpm --filter @polaris/api keys:generate)
JWT_PRIVATE_JWK=
JWT_PUBLIC_JWK=
JWT_KID=dev-1
JWT_ISSUER=polaris
ACCESS_TOKEN_TTL_SECONDS=600
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RECEIPT_SECRET=dev-receipt-secret-change-me

# Paiements électroniques (Phase 5, ADR-0010) — clé maître d'enveloppe des secrets provider (base64 32 octets en prod)
API_PUBLIC_URL=http://localhost:4000
PAYMENT_MASTER_KEY=dev-master-key-change-me-0123456789abcdef
PAYMENT_FAKE_PROVIDER_ENABLED=true
# FEDAPAY_API_BASE_SANDBOX=https://sandbox-api.fedapay.com/v1
# FEDAPAY_API_BASE_LIVE=https://api.fedapay.com/v1
# KKIAPAY_API_BASE_SANDBOX=https://api-sandbox.kkiapay.me/api/v1
# KKIAPAY_API_BASE_LIVE=https://api.kkiapay.me/api/v1
PROVIDER_TIMEOUT_MS=8000
REFRESH_TOKEN_TTL_DAYS_STAFF=30
REFRESH_TOKEN_TTL_DAYS_GUARDIAN=90
REFRESH_TOKEN_TTL_HOURS_PLATFORM=8
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- HTTP ----
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- Passerelles (mode log en local) ----
SMS_PROVIDER=log
EMAIL_PROVIDER=log

# ---- Observabilité ----
SENTRY_DSN=

# ---- Durcissement (Phase 7) ----
# Clé maître pour sceller les secrets TOTP (base64 32 octets en prod) ; à défaut PAYMENT_MASTER_KEY est utilisée
APP_MASTER_KEY=
# Durée d'une session de support (impersonation), 5–120 minutes
IMPERSONATION_TTL_MINUTES=30
# Web : CSP en mode Report-Only par défaut ; passer à true après une semaine sans rapport sur staging
CSP_ENFORCE=false
