# ---- Base de données (rôle applicatif, SANS BYPASSRLS) ----
DATABASE_URL=postgres://polaris_app:polaris_app@localhost:5432/polaris
# Rôle plateforme (BYPASSRLS) : module Platform et migrations uniquement
DATABASE_URL_PLATFORM=postgres://polaris_owner:polaris@localhost:5432/polaris
# Base de test (les tests d'intégration la réinitialisent)
DATABASE_URL_TEST=postgres://polaris_owner:polaris@localhost:5432/polaris_test

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# Clés ES256 au format JWK JSON (générer : pnpm --filter @polaris/api keys:generate)
JWT_PRIVATE_JWK=
JWT_PUBLIC_JWK=
JWT_KID=dev-1
JWT_ISSUER=polaris
ACCESS_TOKEN_TTL_SECONDS=600
RATE_LIMIT_GLOBAL_PER_MINUTE=300
REFRESH_TOKEN_TTL_DAYS_STAFF=30
REFRESH_TOKEN_TTL_DAYS_GUARDIAN=90
REFRESH_TOKEN_TTL_HOURS_PLATFORM=8
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---- HTTP ----
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ---- Passerelles (mode log en local) ----
SMS_PROVIDER=log
EMAIL_PROVIDER=log

# ---- Observabilité ----
SENTRY_DSN=
